<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include inertia macros -->
  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ===== Dimensions (measure your chassis and edit these) ===== -->
  <xacro:property name="chassis_length" value="0.26"/>
  <xacro:property name="chassis_width"  value="0.16"/>
  <xacro:property name="chassis_height" value="0.045"/>
  <xacro:property name="chassis_mass"   value="1.5"/>

  <xacro:property name="wheel_radius" value="0.0635"/> <!-- 127 mm wheel -> radius 63.5 mm -->
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="wheel_mass"   value="0.1"/>
  <xacro:property name="wheel_x"      value="0.09"/>   <!-- front/rear axle offset from centre -->
  <xacro:property name="wheel_y"      value="${chassis_width/2 + wheel_width/2 + 0.005}"/>
  <!-- Chassis bottom sits this high above the wheel axles -->
  <xacro:property name="chassis_z"    value="0.01"/>

  <!-- Materials -->
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="blue"><color rgba="0.1 0.3 1 1"/></material>

  <!-- Base link: centre of the robot, at wheel axle height -->
  <link name="base_link"/>

  <!-- Footprint: projection of base_link on the ground (used by Nav2) -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}"/>
  </joint>
  <link name="base_footprint"/>

  <!-- Chassis -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_z}"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_height/2}"/>
    </xacro:inertial_box>
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ===== WHEELS (4WD skid steer, non-encoded DC motors) ===== -->
  <!-- prefix: front_left etc.  x/y: position  -->
  <xacro:macro name="wheel" params="prefix x y">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Roll the cylinder so its axis points along +Y -->
      <origin xyz="${x} ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/Blue</material>
      <!-- Skid steer needs some lateral slip to turn in place -->
      <mu1>1.0</mu1>
      <mu2>0.5</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel prefix="front_right" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel prefix="rear_left"   x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wheel prefix="rear_right"  x="${-wheel_x}" y="${-wheel_y}"/>

</robot>
