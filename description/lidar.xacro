<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 2D LiDAR (RPLIDAR A1) mounted top-centre of the chassis.
       lidar_yaw: set to pi if the real scan appears rotated 180 deg in RViz. -->
  <xacro:property name="lidar_height" value="0.03"/>
  <xacro:property name="lidar_yaw"    value="0.0"/>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${chassis_height + 0.03 + lidar_height/2}" rpy="0 0 ${lidar_yaw}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="${lidar_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.12" length="${lidar_height}" radius="0.035">
      <origin xyz="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- Simulated LiDAR, matched to RPLIDAR A1 specs (360 deg, 0.15-12 m, ~5.5 Hz) -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>5.5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
